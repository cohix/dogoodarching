{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts"]
}
