{
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "zod": "^4.0.0"
  },
  "description": "Do Good Arching — multi-user archery training tracker for athletes and coaches. Cloudflare Workers + D1 + R2.",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "name": "do-good-arching",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "dev": "wrangler dev",
    "dev:client": "vite dev --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p test/worker/tsconfig.json && tsc --noEmit -p test/frontend/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:worker": "vitest run --project worker",
    "test:frontend": "vitest run --project frontend",
    "db:migrate:local": "wrangler d1 migrations apply do-good-arching --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate": "wrangler d1 migrations apply do-good-arching --remote",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "type": "module",
  "version": "1.0.0"
}
