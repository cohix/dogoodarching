FROM debian:bookworm-slim

# System packages required for building, testing, and running this project.
#   - python3/g++/make: node-gyp fallback builds for native npm modules
#   - sqlite3: inspect the local D1 database under .wrangler/state
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    gnupg \
    make \
    g++ \
    python3 \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS (package.json requires >=20; wrangler 4 and vite 7 need >=20.19).
ARG NODE_MAJOR=22
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# Keep wrangler from prompting for telemetry consent in non-interactive runs.
ENV WRANGLER_SEND_METRICS=false

WORKDIR /workspace
